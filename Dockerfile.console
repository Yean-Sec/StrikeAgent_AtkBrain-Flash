# StrikeAgent_AtkBrain-Flash — 控制台一键镜像（本机功能口径）
# 与根目录 Dockerfile（TSecBench 托管、ATKBRAIN_HOSTED=1、无前端）分开。
# 构建：docker compose -f compose.yaml -f deploy/compose.build.yaml up -d --build --wait
ARG NODE_IMAGE=docker.m.daocloud.io/library/node:20-bookworm-slim
ARG PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim-bookworm

FROM ${NODE_IMAGE} AS frontend
ENV NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npx vite build

FROM ${PYTHON_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
    PIP_TRUSTED_HOST=mirrors.aliyun.com \
    NPM_CONFIG_REGISTRY=https://registry.npmmirror.com \
    ATKBRAIN_HOSTED=0 \
    ATKBRAIN_LLM_GATEWAY=0 \
    ATKBRAIN_HOST=0.0.0.0 \
    ATKBRAIN_PORT=2333 \
    ATKBRAIN_PI_BIN=pi \
    ATKBRAIN_PI_PROVIDER=deepseek \
    ATKBRAIN_PI_MODEL=deepseek-flash \
    ATKBRAIN_CLAUDE_MODEL=deepseek-flash \
    ATKBRAIN_CLAUDE_FALLBACK_MODEL=deepseek-flash \
    ATKBRAIN_SUPERVISOR_MODEL=deepseek-flash \
    ATKBRAIN_EVOLVE_MODEL=deepseek-flash \
    ATKBRAIN_REPORT_MODEL=deepseek-flash \
    ATKBRAIN_ADMIN_USER=admin \
    ATKBRAIN_CORS_ORIGINS="http://127.0.0.1:2334,http://localhost:2334,http://127.0.0.1:2333,http://localhost:2333" \
    PI_TELEMETRY=0 \
    PI_SKIP_VERSION_CHECK=1 \
    PI_OFFLINE=1 \
    HOME=/root \
    PATH=/opt/atkbrain/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources; \
    fi; \
    if [ -f /etc/apt/sources.list ]; then \
      sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list; \
    fi; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      ca-certificates curl wget git jq vim-tiny less procps iproute2 iputils-ping \
      gcc g++ make nasm pkg-config libffi-dev libssl-dev \
      unzip p7zip-full xz-utils file bsdmainutils xxd binutils elfutils \
      strace tmux openssl socat netcat-traditional \
      libcairo2 libpango-1.0-0 libpangocairo-1.0-0 libgdk-pixbuf-2.0-0 \
      libpangoft2-1.0-0 libharfbuzz0b libfribidi0 \
      shared-mime-info fonts-dejavu-core \
      nmap gdb php-cli ruby \
      default-mysql-client redis-tools postgresql-client \
      smbclient libimage-exiftool-perl; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*; \
    NODE_VER=22.18.0; \
    arch="$(uname -m)"; \
    case "$arch" in \
      x86_64|amd64) node_arch=linux-x64 ;; \
      aarch64|arm64) node_arch=linux-arm64 ;; \
      *) echo "[docker] 不支持的 Node 架构 $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://npmmirror.com/mirrors/node/v${NODE_VER}/node-v${NODE_VER}-${node_arch}.tar.xz" \
      | tar -xJ -C /usr/local --strip-components=1; \
    node --version; \
    npm --version

# 渗透工具：仓库没有的跳过，避免整层失败
RUN set -eux; \
    apt-get update; \
    for p in \
      ncat gdbserver sqlmap nikto gobuster dirb wfuzz hydra john \
      radare2 binwalk sslscan foremost steghide python3-impacket \
      python3-pycryptodome python3-sympy python3-bs4 python3-pil \
      ffuf feroxbuster masscan whatweb wafw00f hashid enum4linux tshark checksec \
      nuclei gobuster dnsutils ldap-utils snmp nfs-common \
      sshpass proxychains4 hashcat medusa ncrack \
      smbmap exploitdb theharvester cewl onesixtyone \
      tesseract-ocr wordlists seclists dirbuster dnsmap \
    ; do \
      apt-get install -y --no-install-recommends "$p" || echo "[docker] skip $p"; \
    done; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

COPY scripts/docker-seed-wordlists.sh /tmp/docker-seed-wordlists.sh
RUN chmod 0755 /tmp/docker-seed-wordlists.sh && /tmp/docker-seed-wordlists.sh && rm -f /tmp/docker-seed-wordlists.sh

WORKDIR /opt/atkbrain/backend

COPY backend/requirements.txt /opt/atkbrain/backend/requirements.txt

RUN set -eux; \
    python3 -m venv /opt/atkbrain/venv; \
    /opt/atkbrain/venv/bin/pip install --upgrade pip; \
    /opt/atkbrain/venv/bin/pip install --no-cache-dir -r /opt/atkbrain/backend/requirements.txt; \
    npm install -g @earendil-works/pi-coding-agent; \
    npm cache clean --force; \
    rm -rf /root/.npm; \
    mkdir -p /opt/atkbrain/backend/data/workspaces \
             /opt/atkbrain/backend/data/loot \
             /opt/atkbrain/backend/data/reports \
             /opt/atkbrain/backend/data/logs \
             /opt/atkbrain/frontend/dist; \
    command -v pi >/dev/null; \
    pi --version || true

COPY backend/atkbrain /opt/atkbrain/backend/atkbrain
COPY skills /opt/atkbrain/skills
COPY pi/extensions /opt/atkbrain/pi/extensions
COPY tools /opt/atkbrain/tools
COPY --from=frontend /src/frontend/dist /opt/atkbrain/frontend/dist
COPY VERSION /opt/atkbrain/VERSION
COPY scripts/docker-console-entrypoint.sh /opt/atkbrain/docker-console-entrypoint.sh
COPY scripts/atkbrain-upgrade.sh /opt/atkbrain/scripts/atkbrain-upgrade.sh

RUN chmod 0755 /opt/atkbrain/docker-console-entrypoint.sh /opt/atkbrain/scripts/atkbrain-upgrade.sh \
    && find /opt/atkbrain/backend/atkbrain -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true \
    && test -f /opt/atkbrain/frontend/dist/index.html \
    && test -f /opt/atkbrain/VERSION \
    && test -f /opt/atkbrain/skills/recon-fanout/SKILL.md \
    && test -f /opt/atkbrain/pi/extensions/atkbrain-tools.ts

EXPOSE 2333 2334

HEALTHCHECK --interval=10s --timeout=5s --start-period=90s --retries=18 \
    CMD python3 -m atkbrain.healthcheck

ENTRYPOINT ["/opt/atkbrain/docker-console-entrypoint.sh"]
