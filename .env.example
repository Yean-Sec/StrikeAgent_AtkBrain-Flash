# 复制为 .env 后再 docker compose。不要把填好的 .env 提交进 git。
# cp .env.example .env

# 模型不在这里配。控制台起来后到「设置 → Pi 模型」改 JSON
# （文件是 backend/data/pi-models.json）。在 providers 里写 apiKey，
# 用 defaultProvider / defaultModel 指定要用的模型。下面两项留空即可。
DEEPSEEK_API_KEY=
ANTHROPIC_AUTH_TOKEN=

# 控制台登录（首次写入；登录后必须改密）
ATKBRAIN_ADMIN_USER=admin
ATKBRAIN_ADMIN_PASSWORD=admin

# 改密时设为 1。不要写成空：ATKBRAIN_ADMIN_PASSWORD_RESET= 会让容器起不来
# ATKBRAIN_ADMIN_PASSWORD_RESET=1

# 安全入口：空=本机 secrets 生成 8 位路径（不能在此指定字符串）。
# 仅本机 npm run dev 可关掉：ATKBRAIN_SECURITY_ENTRY=off
# ATKBRAIN_SECURITY_ENTRY=

# 监听。host 网络下 0.0.0.0 才能用局域网 IP 打开控制台
ATKBRAIN_HOST=0.0.0.0
ATKBRAIN_PORT=2333

# 浏览器走 https://<主机>:2334（Caddy / systemd 自签 TLS）。开 Cookie 后不要用 *
ATKBRAIN_CORS_ORIGINS=https://127.0.0.1:2334,https://localhost:2334,http://127.0.0.1:2333,http://localhost:2333

# HTTPS 默认开。应用仍是 HTTP :2333。有域名且放行 80/443 时叠 deploy/compose.caddy.yaml 换 Let's Encrypt。
ATKBRAIN_FORCE_HTTPS=true
ATKBRAIN_SKIP_SOCAT=true
# ATKBRAIN_PUBLIC_HOST=atkbrain.example.com
# ATKBRAIN_PUBLIC_ORIGIN=https://atkbrain.example.com

# Pi
ATKBRAIN_PI_BIN=pi
ATKBRAIN_PI_PROVIDER=deepseek
ATKBRAIN_PI_MODEL=deepseek-flash
# 历史变量，与 ATKBRAIN_PI_MODEL 同义。只在还没有 backend/data/pi-models.json 时作为种子。
# 控制台「设置 → Pi 模型」保存的 defaultModel 优先。
# ATKBRAIN_CLAUDE_MODEL=
# 进程闸（防孤儿堆到几百）。从者+工人默认每猎 4，整机 32
# ATKBRAIN_PI_MAX_LIVE=32
# ATKBRAIN_PI_PER_PROJECT=4
# ATKBRAIN_PI_WORKER_IDLE_SEC=180

# 会话：登录起算 24 小时，到期必须重新登录（不滑动续期）
# ATKBRAIN_SESSION_MAX_AGE_SEC=86400

# 可选：Pi / 脚本调 API 用的令牌（浏览器走登录会话，不必填）
# ATKBRAIN_API_TOKEN=
